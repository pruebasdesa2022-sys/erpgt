{
  "Serilog": {
    "MinimumLevel": {
      "Default": "Information",
      "Override": {
        "Microsoft.AspNetCore": "Warning",
        "Microsoft.Hosting.Lifetime": "Information"
      }
    }
  },
  "Logs": {
    "Carpeta": "logs",
    "DiasRetencion": 30
  },
  "Jwt": {
    "Emisor": "erp-api",
    "Audiencia": "erp-frontend",
    "MinutosAcceso": 15,
    "DiasRefresh": 7
  },
  "Frontend": {
    "Url": "http://localhost:3000"
  },
  "Cors": {
    "Origenes": [ "http://localhost:3000" ]
  },
  "LimiteTasa": {
    "AutenticacionPorMinuto": 10
  },
  "Correo": {
    "Modo": "Archivo",
    "Carpeta": "correo-saliente",
    "Remitente": "no-responder@erp.local",
    "NombreRemitente": "ERP",
    "Servidor": "",
    "Puerto": 587
  },
  "AllowedHosts": "*"
}
