# Copie este archivo como .env.local (desarrollo) o .env.production (solo en el servidor).
# Ninguna de estas variables llega al navegador; no use el prefijo NEXT_PUBLIC_ para secretos.

# URL interna de la API. El navegador nunca la usa: solo el servidor de Next (BFF).
API_URL=http://localhost:5080

# Solo para probar desde otro equipo o el celular con `corepack yarn dev`: la IP de esta PC en la red (sin puerto).
# Varias separadas por comas. Déjela vacía en producción.
# DEV_ORIGINS=192.168.1.50
