{
  "version": "0.2.0",
  "configurations": [
    {
      "name": "API (.NET)",
      "type": "coreclr",
      "request": "launch",
      "preLaunchTask": "backend: compilar",
      "program": "${workspaceFolder}/backend/src/ERP.Api/bin/Debug/net10.0/ERP.Api.dll",
      "cwd": "${workspaceFolder}/backend/src/ERP.Api",
      "env": {
        "ASPNETCORE_ENVIRONMENT": "Development",
        "ASPNETCORE_URLS": "http://localhost:5080"
      },
      "stopAtEntry": false
    },
    {
      "name": "Frontend (Next.js)",
      "type": "node-terminal",
      "request": "launch",
      "command": "corepack yarn dev",
      "cwd": "${workspaceFolder}/frontend"
    }
  ],
  "compounds": [
    {
      "name": "API + Frontend",
      "configurations": ["API (.NET)", "Frontend (Next.js)"]
    }
  ]
}
