{
  "version": "2.0.0",
  "tasks": [
    {
      "label": "backend: compilar",
      "type": "process",
      "command": "dotnet",
      "args": ["build", "${workspaceFolder}/backend/ERP.sln"],
      "group": { "kind": "build", "isDefault": true },
      "problemMatcher": "$msCompile"
    },
    {
      "label": "backend: pruebas",
      "type": "process",
      "command": "dotnet",
      "args": ["test", "${workspaceFolder}/backend/ERP.sln"],
      "group": "test",
      "problemMatcher": "$msCompile"
    },
    {
      "label": "frontend: desarrollo",
      "type": "shell",
      "command": "corepack yarn dev",
      "options": { "cwd": "${workspaceFolder}/frontend" },
      "isBackground": true,
      "problemMatcher": []
    },
    {
      "label": "frontend: pruebas",
      "type": "shell",
      "command": "corepack yarn test",
      "options": { "cwd": "${workspaceFolder}/frontend" },
      "group": "test",
      "problemMatcher": []
    }
  ]
}
